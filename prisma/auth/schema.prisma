generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@generated/auth"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  OWNER
  STAFF
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  name String
  role UserRole @default(OWNER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
