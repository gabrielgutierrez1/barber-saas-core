generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@generated/manager"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Tenant {
  id String @id @db.Uuid
  slug String @unique
  name String
  description String?
  logoUrl String?
  primaryColor String @default("#c48860")
  timeZone String @default("America/Santiago")
  openingHour Int @default(9)
  closingHour Int @default(19)
  active Boolean @default(true)
  databases TenantDatabase[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model TenantDatabase {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  service String
  connectionUrl String @db.Text
  @@unique([tenantId, service])
}
