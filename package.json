{
  "name": "peluqueria-saas",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build --workspace frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "typecheck": "npm run build:backend && tsc -p backend/tsconfig.json --noEmit && tsc -p backend/test/tsconfig.json && tsc -p frontend/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "test": "node --import tsx --test backend/test/*.test.ts",
    "test:integration": "npm run build:backend && node --import tsx --test backend/test/integration/*.test.ts",
    "db:import-legacy": "tsx scripts/import-legacy.ts",
    "test:smtp": "npm run build:backend && node --import tsx --test backend/test/integration/email-delivery.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.15.0",
    "@types/express": "^4.17.21",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "mercadopago": "^2.13.0",
    "nodemailer": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.0",
    "prettier": "3.6.2",
    "prisma": "^6.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
