{
  "name": "peluqueria-saas",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build:gateway": "tsc -p apps/gateway/tsconfig.json",
    "build:catalog": "tsc -p apps/catalog-service/tsconfig.json",
    "build:reservations": "tsc -p apps/reservations-service/tsconfig.json",
    "build:payments": "tsc -p apps/payments-service/tsconfig.json",
    "build:backend": "npm run build:manager && npm run build:auth && npm run build:gateway && npm run build:catalog && npm run build:reservations && npm run build:payments",
    "db:generate": "node scripts/prisma-all.mjs generate",
    "db:migrate": "node scripts/prisma-all.mjs migrate",
    "db:seed": "tsx scripts/seed.ts",
    "dev:gateway": "tsx watch apps/gateway/src/main.ts",
    "dev:catalog": "tsx watch apps/catalog-service/src/main.ts",
    "dev:reservations": "tsx watch apps/reservations-service/src/main.ts",
    "dev:payments": "tsx watch apps/payments-service/src/main.ts",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:manager": "tsc -p apps/tenant-manager/tsconfig.json",
    "build:auth": "tsc -p apps/auth-service/tsconfig.json",
    "dev:manager": "tsx watch apps/tenant-manager/src/main.ts",
    "dev:auth": "tsx watch apps/auth-service/src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "mercadopago": "^2.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "dotenv": "^16.4.7",
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.0.0",
    "prisma": "^6.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
