# Copiar por instalación. Nunca compartir secretos entre propietarios.
COMPOSE_PROJECT_NAME=salon
POSTGRES_PASSWORD=CAMBIAR_ADMIN_POSTGRES
# Generar con openssl rand -hex 24 (sin caracteres reservados de URL).
DATABASE_PASSWORD=CAMBIAR_PASSWORD_APP
# Desarrollo local: host/puerto accesible. Compose reemplaza esta URL.
DATABASE_URL=postgresql://salon_app:CAMBIAR_PASSWORD_APP@localhost:5432/salon?schema=public
JWT_SECRET=CAMBIAR_CON_OPENSSL_RAND_HEX_32
SALON_NAME=Mi peluquería
SEED_ADMIN_EMAIL=propietario@example.com
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_INICIAL
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_SERVER_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BACKGROUND_JOBS=true
