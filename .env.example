# Copiar por instalación. Nunca compartir secretos entre propietarios.
COMPOSE_PROJECT_NAME=salon
POSTGRES_PASSWORD=CAMBIAR_ADMIN_POSTGRES
# Generar con openssl rand -hex 24 (sin caracteres reservados de URL).
DATABASE_PASSWORD=CAMBIAR_PASSWORD_APP
# Desarrollo local: host/puerto accesible. Compose reemplaza esta URL.
DATABASE_URL=postgresql://salon_app:CAMBIAR_PASSWORD_APP@localhost:5432/salon?schema=public
JWT_SECRET=CAMBIAR_CON_OPENSSL_RAND_HEX_32
SALON_NAME=Mi peluquería
SEED_ADMIN_EMAIL=propietario@example.com
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_INICIAL
# Origen del FRONTEND, sin rutas. HTTP local no habilita Checkout Pro.
# Para pagar: dominio HTTPS público y abrir la reserva desde ese mismo origen.
# Ver docs/mercadopago-return.md para túneles y cambios de dominio.
PUBLIC_WEB_URL=http://localhost:3000
# URL pública del BACKEND. Cambiarla requiere reconstruir el frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_SERVER_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Backend HTTPS + /api/webhooks/mercadopago (no la URL del frontend).
MP_WEBHOOK_URL=
# SMTP local con Mailpit; para producción ver README (Brevo).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mi peluquería <no-reply@salon.test>"
BACKGROUND_JOBS=true
