FROM node:22-bookworm-slim AS build
WORKDIR /srv/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
RUN npm ci --no-audit --no-fund
COPY tsconfig.base.json ./
COPY backend ./backend
RUN DATABASE_URL=postgresql://unused:unused@localhost:5432/unused npm run db:generate && npm run build:backend
FROM node:22-bookworm-slim
WORKDIR /srv/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY --from=build /srv/app/node_modules ./node_modules
COPY --from=build /srv/app/package*.json ./
COPY --from=build /srv/app/frontend/package.json ./frontend/package.json
COPY --from=build /srv/app/backend ./backend
RUN mkdir -p /srv/app/uploads && chown node:node /srv/app/uploads
USER node
EXPOSE 4000
CMD ["node","backend/dist/main.js"]
