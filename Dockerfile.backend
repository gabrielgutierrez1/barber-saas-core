FROM node:22-bookworm-slim AS build
WORKDIR /srv/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm install --no-audit --no-fund
COPY prisma ./prisma
RUN npm run db:generate
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/gateway ./apps/gateway
COPY apps/catalog-service ./apps/catalog-service
COPY apps/reservations-service ./apps/reservations-service
COPY apps/payments-service ./apps/payments-service
COPY apps/tenant-manager ./apps/tenant-manager
COPY apps/auth-service ./apps/auth-service
RUN npm run build:backend
FROM node:22-bookworm-slim
WORKDIR /srv/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY --from=build /srv/app/node_modules ./node_modules
COPY --from=build /srv/app/package.json ./package.json
COPY --from=build /srv/app/apps/web/package.json ./apps/web/package.json
COPY --from=build /srv/app/dist ./dist
COPY --from=build /srv/app/prisma ./prisma
COPY --from=build /srv/app/packages ./packages
COPY scripts ./scripts
EXPOSE 4000 4001 4002 4003 4004 4005
